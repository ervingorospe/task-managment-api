# Copy to .env and adjust for your local setup.
DATABASE_URL=

PORT=3001

# S3 bucket for ticket attachments (see modules/storage/s3.service.ts).
# The bucket must allow public s3:GetObject and the IAM user below must be
# scoped to just this bucket's PutObject/GetObject/DeleteObject — see the
# setup steps wherever this was discussed with the team.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email sending via SendGrid's HTTPS API (see
# modules/email/mailer.service.ts) — wired into member invites
# (member.service.ts), signup verification, and invite-response emails.
# Not SMTP: deliberately avoids it so this keeps working on hosts that
# block outbound SMTP ports (e.g. Render's free tier). SENDGRID_API_KEY
# comes from SendGrid's dashboard (Settings -> API Keys). SENDGRID_SENDER
# must be a verified identity there (Settings -> Sender Authentication ->
# Single Sender Verification works without owning a domain) — mail is
# sent From this address.
SENDGRID_API_KEY=
SENDGRID_SENDER=

# Base URL of the frontend app — used to build the "Accept invite" link in
# invite emails, and where OAuth/verify-email redirect back to.
# Defaults to the local dev server if unset.
FRONTEND_URL=http://localhost:3000

# This backend's own public URL — used to build the verify-email link
# (GET /auth/verify-email must point at this backend, not the frontend).
# Defaults to http://localhost:$PORT if unset.
BACKEND_URL=http://localhost:3001

# Auth (see modules/auth/). Google OAuth credentials come from
# https://console.cloud.google.com/apis/credentials — GOOGLE_CALLBACK_URL
# must exactly match a redirect URI registered there
# (http://localhost:3001/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Signs session JWTs — any long random string, not from Google.
JWT_SECRET=
